# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Virtual envs / secrets
.venv/
venv/
.env

# Pipeline cache and large outputs (regenerable; keep out of git)
cache/
dataset/*
!dataset/DATA_DICTIONARY.md
# vClaire v2 dataset caches/outputs (regenerable; same policy as v1 cache/dataset)
cache_v2/
dataset_v2/
# v2 5-image dev harness (regenerable via scripts/probes/_setup_dev_dataset.py;
# cache_v2_dev is a junction to cache_v2, dataset_v2_dev holds copied + S128 outputs)
cache_v2_dev/
dataset_v2_dev/

# Build artifacts
build/
dist/
*.egg-info/
# Rendered report PDFs (regenerable from docs/*.md)
docs/*.pdf

# Downloaded / large geospatial rasters (HiRISE JP2s, CTX tiles)
*.jp2
*.JP2
*.tif
*.tiff
*.img

# HiRISE JP2 download cache (~200-500 MB per image)
cache/hirise_jp2/

# Trained models (future work)
models/
*.pkl
*.joblib

# Regional-map rasters + run checkpoints (475 MB; regenerable on Sherlock — the *.tif rule
# already blocks the rasters, this also keeps the per-tile .json checkpoints out)
reports/map_region/
# ...and every OTHER map-output generation. 2026-08-24: `reports/map_region_g2/` was not covered
# by the line above, so unpacking the rebuild download put 288 `.npz` window checkpoints (28.6 MB)
# into a commit. The rasters were saved only by the global `*.tif` rule. Glob the generations.
reports/map_region_g2/
reports/map_region*/
reports/map_a1*/
# The growable extension product (DECISIONS 2026-08-28b). Same rule -- rasters and per-tile
# checkpoints stay out -- with ONE exception: `plan.json` is the footprint definition AND the
# input `run_map_extended_array.sbatch` reads on Sherlock, so it has to travel with the code.
# NOTE the trailing `/*`, not `/`: git will not re-include a file inside an EXCLUDED DIRECTORY,
# so `reports/map_extended*/` plus a `!` line silently keeps plan.json out. Excluding the
# directory's CONTENTS lets git descend and honour the negation.
reports/map_extended*/*
!reports/map_extended/plan.json
# Per-tile LOIO prediction dump (18 MB; regenerable via scripts/striping_a1_loio.py;
# the small striping_a1_loio_summary.csv IS tracked)
reports/figures/striping_a1_loio_preds.csv
# F-pilot bulk inputs + phase caches (GBs; the crops tar comes from Sherlock, the work dirs
# are recomputable by scripts/f_pilot_crop.py; final figures/CSVs in reports/figures ARE tracked)
reports/f_timing/pilot_crops.tar
reports/f_timing/pilot_work/
reports/f_timing/pilot_work_smoke/
# H2 per-frame embedding cache (540M; recomputable by scripts/f_h2_nuisance.py — the
# summary h2_nuisance_basis.npz IS tracked)
reports/f_leg_b/h2_frame_emb/
# F-build Stage-B per-frame logits (709M, 906 npz) + the Stage-C overlap-graph cache (42M).
# PLAN_FBuild was aborted 2026-07-30 but these are KEPT ON DISK: the npzs cost ~33 GPU-h on
# Sherlock to regenerate (and scratch gets purged), and Stage C re-runs in ~2 min from the edge
# cache. Every conclusion drawn from them is in reports/figures/fbuild_* (tracked).
reports/f_region_logits/
reports/f_stagec/
# Gate-5/6 cohort scoring table (5.9M; regenerable by scripts/f_region_gates.py — the derived
# fbuild_abort_level_vs_labels.csv, which is what the abort call rests on, IS tracked)
reports/figures/fbuild_cohort_join.parquet

# Background-sweep logs
logs/
scripts/probes/*.log

# Claude Code session-local state (settings.json + settings.local.json are committed
# manually; the lock file is per-session and must not be tracked).
.claude/scheduled_tasks.lock
.claude/settings.local.json

# Editor / OS cruft
.vscode/
.DS_Store
Thumbs.db
# H3 consistency pairs (169M; recomputable via scripts/f_h3_pairs.py from the h2_frame_emb cache)
reports/f_leg_b/h3_consistency_pairs.npz
reports/f_build/probe_cubes/
cache/pds_index/
